{
  "name": "dsh-control",
  "version": "0.1.0",
  "description": "dsh-control: connect and manage remote dsh web instances from the local GUI — SSH-tunnel onboarding wizard, live session browser, one-click remote GUI handoff.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=24",
    "dsh": "^0.2.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.0-rc.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "remote-hosts",
    "multi-host",
    "ssh-tunnel"
  ],
  "license": "MIT",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "author": "6mt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/6mt/dsh-control.git"
  },
  "homepage": "https://github.com/6mt/dsh-control#readme",
  "bugs": {
    "url": "https://github.com/6mt/dsh-control/issues"
  }
}